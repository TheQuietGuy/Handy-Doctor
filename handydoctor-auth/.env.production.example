# ══════════════════════════════════════════════════════════════════════════════
# HandyDoctor — Production Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.production (never commit that file):
#   cp .env.production.example .env.production
#
# Then fill in every value marked [REQUIRED].
# Values marked [OPTIONAL] have sensible production defaults.

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] asyncpg connection string.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# In docker-compose.prod.yml the host is the service name "postgres".
DATABASE_URL=postgresql+asyncpg://hduser:CHANGE_ME_DB_PASSWORD@postgres:5432/handydoctor

# ── Redis ─────────────────────────────────────────────────────────────────────
# [REQUIRED] Redis connection string.
# In docker-compose.prod.yml the host is the service name "redis".
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ── JWT / RSA keys ────────────────────────────────────────────────────────────
# [REQUIRED] Paths to the RSA-2048 key pair generated by scripts/generate-keys.sh
# In production these are mounted into the container as read-only secrets.
JWT_PRIVATE_KEY_PATH=/run/secrets/private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/public_key
JWT_ALGORITHM=RS256

# [OPTIONAL] Token lifetimes. Defaults are conservative and secure.
# Shorter access tokens = smaller attack window if a token is leaked.
# Longer refresh tokens = better UX (users stay logged in longer).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# [REQUIRED for Google login] Credentials from Google Cloud Console.
# Create at: https://console.cloud.google.com/apis/credentials
# Set Authorised redirect URI to: https://YOUR_DOMAIN/api/accounts/oauth/google/callback
GOOGLE_CLIENT_ID=your-project.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-CHANGE_ME
GOOGLE_REDIRECT_URI=https://handydoctor.app/api/accounts/oauth/google/callback

# ── Email (Resend) ────────────────────────────────────────────────────────────
# [REQUIRED] API key from https://resend.com
# Free tier: 3,000 emails/month, 1 custom domain.
# Paid tier: from $20/month for 50k emails.
RESEND_API_KEY=re_CHANGE_ME

# [OPTIONAL] From address shown to recipients.
# Must match a verified domain in your Resend account.
EMAIL_FROM=noreply@handydoctor.app
EMAIL_FROM_NAME=HandyDoctor

# ── OpenAI (optional — leave blank to use mock RAG generator) ─────────────────
# [OPTIONAL] If set, real GPT-4o responses are generated instead of mock ones.
# Billing: ~$0.002 per consultation at GPT-4o-mini pricing.
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o-mini

# ── Application ───────────────────────────────────────────────────────────────
# [REQUIRED] Your production domain. Used to build links in emails.
FRONTEND_URL=https://handydoctor.app

APP_NAME=HandyDoctor

# [REQUIRED] Long random string (≥ 64 chars) used for CSRF and internal signing.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_64

# [REQUIRED] Comma-separated list of allowed CORS origins.
# Include your frontend domain and any preview/staging domains.
ALLOWED_ORIGINS=https://handydoctor.app,https://www.handydoctor.app

# ── Security ──────────────────────────────────────────────────────────────────
# [OPTIONAL] Set to "true" to trust X-Forwarded-For from nginx.
# Only enable when nginx is the only entry point (true in docker-compose.prod).
TRUST_PROXY=true

# [OPTIONAL] Rate limiting thresholds (requests / window in seconds).
# These supplement the per-route limits in app/middleware/config.py.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── GDPR / Privacy ───────────────────────────────────────────────────────────
# [OPTIONAL] Grace period before a deletion request is executed.
ACCOUNT_DELETION_GRACE_DAYS=14

# [OPTIONAL] Hours before an email verification link expires.
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# ── Uvicorn / server ─────────────────────────────────────────────────────────
# [OPTIONAL] Number of uvicorn worker processes.
# Rule of thumb: (2 × CPU cores) + 1. For a 2-core server: 5.
UVICORN_WORKERS=4

# ── PostgreSQL (used by the postgres service in docker-compose.prod.yml) ───────
# [REQUIRED] Must match the password in DATABASE_URL above.
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=handydoctor
POSTGRES_USER=hduser

# ── Redis (used by the redis service in docker-compose.prod.yml) ───────────────
# [REQUIRED] Must match the password in REDIS_URL above.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
