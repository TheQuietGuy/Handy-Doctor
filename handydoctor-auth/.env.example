# ── Database ───────────────────────────────────────────────────────────────────
# Replace with your actual PostgreSQL credentials
DATABASE_URL=postgresql+asyncpg://hduser:devpassword@localhost:5432/handydoctor

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT keys (generated by scripts/generate-keys.sh) ──────────────────────────
JWT_PRIVATE_KEY_PATH=private.pem
JWT_PUBLIC_KEY_PATH=public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Secret key — REQUIRED ──────────────────────────────────────────────────────
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-this-with-a-real-64-char-random-hex-string

# ── Email via Resend — REQUIRED for email features ─────────────────────────────
# Get a free key at https://resend.com (3,000 emails/month free)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=HandyDoctor

# ── App ────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ── Google OAuth (optional — leave blank to disable Google login) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/accounts/oauth/google/callback

# ── OpenAI (optional — leave blank to use mock AI responses) ───────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Misc ───────────────────────────────────────────────────────────────────────
TRUST_PROXY=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ACCOUNT_DELETION_GRACE_DAYS=14
EMAIL_VERIFICATION_EXPIRE_HOURS=24
